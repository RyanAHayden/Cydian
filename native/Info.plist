<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>$(BRAND_NAME)</string>
	<key>CFBundleIdentifier</key><string>com.ryha.ifizbox</string>
	<key>CFBundleName</key><string>$(BRAND_NAME)</string>
	<key>CFBundleDisplayName</key><string>$(BRAND_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>@VERSION@</string>
	<key>CFBundleVersion</key><string>@BUILD@</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleSupportedPlatforms</key><array><string>iPhoneOS</string></array>
	<key>DTPlatformName</key><string>iphoneos</string>
	<key>MinimumOSVersion</key><string>@MIN@</string>
	<key>UIDeviceFamily</key><array><integer>1</integer></array>
	<key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
	<key>CFBundleIcons</key><dict>
		<key>CFBundlePrimaryIcon</key><dict>
			<key>CFBundleIconFiles</key><array><string>AppIcon60x60</string></array>
			<key>CFBundleIconName</key><string>AppIcon</string>
		</dict>
	</dict>
	<!-- F57: reading a vendor's payment secret from the Keychain asks for Face ID (Paid.swift) -->
	<key>NSFaceIDUsageDescription</key><string>Face ID unlocks your payment details when you buy a package.</string>
	<!-- N6: an app in /Applications (a system app to iOS, like Sileo) gets no Settings > Notifications entry
	     without this, so its permission prompt is forgotten and the daemon's "n Upgrades" and badge are dropped. -->
	<key>SBAppUsesLocalNotifications</key><true/>
	<key>UIApplicationSceneManifest</key><dict>
		<key>UIApplicationSupportsMultipleScenes</key><false/>
		<key>UISceneConfigurations</key><dict>
			<key>UIWindowSceneSessionRoleApplication</key><array><dict>
				<key>UISceneConfigurationName</key><string>Default</string>
			</dict></array>
		</dict>
	</dict>
	<key>UILaunchScreen</key><dict>
		<key>UIImageName</key><string>LaunchLoading</string>
		<key>UIImageRespectsSafeAreaInsets</key><false/>
	</dict>
	<key>UIStatusBarStyle</key><string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
	<key>CADisableMinimumFrameDurationOnPhone</key><true/>
	<!-- N9: Open in iFizBox for .ipa and .deb (Files, Mail, AirDrop, Safari's downloads; share/App/ShareBridge.swift),
	     and the ifizbox:// scheme the share extension opens (ifizbox://share?url=…). Info-sideload.plist repeats these
	     with F77's types, since mkipa.py's overlay replaces a key whole. iOS copies a file into Documents/Inbox. -->
	<key>LSSupportsOpeningDocumentsInPlace</key><false/>
	<key>CFBundleDocumentTypes</key><array>
		<dict>
			<key>CFBundleTypeName</key><string>iOS App</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>com.apple.itunes.ipa</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Debian package</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>org.debian.deb-archive</string></array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key><array>
		<dict>
			<key>CFBundleURLName</key><string>com.ryha.ifizbox</string>
			<key>CFBundleURLSchemes</key><array><string>ifizbox</string></array>
		</dict>
	</array>
	<!-- iOS has no system type for .deb: declare it, as Sileo and Zebra do. .ipa too: iOS 15+ may not declare com.apple.itunes.ipa, and without it Safari's downloads and Files leave the app out of the share sheet (user 2026-11-18). -->
	<key>UTImportedTypeDeclarations</key><array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.apple.itunes.ipa</string>
			<key>UTTypeDescription</key><string>iOS App</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string><string>public.zip-archive</string></array>
			<key>UTTypeTagSpecification</key><dict>
				<key>public.filename-extension</key><array><string>ipa</string><string>tipa</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>org.debian.deb-archive</string>
			<key>UTTypeDescription</key><string>Debian package</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string><string>public.archive</string></array>
			<key>UTTypeTagSpecification</key><dict>
				<key>public.filename-extension</key><array><string>deb</string></array>
				<key>public.mime-type</key><array><string>application/vnd.debian.binary-package</string><string>application/x-debian-package</string></array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
