--- a/src/common/fs.cpp
+++ b/src/common/fs.cpp
@@ -58,7 +58,18 @@
 		if (MAP_FAILED == base) {
 			base = NULL;
 		}
+#ifdef __EMSCRIPTEN__
+		// Emscripten writes a MAP_SHARED mapping back to the file at munmap through the mapping's fd, so it must
+		// stay open until then: closed here, munmap wrote the signed Mach-O to whatever file reused the fd (or
+		// nowhere) and the app kept its old signature (iFizBox, website signing, 2026-11-18).
+		if (NULL != base) {
+			s_mapFiles[base] = (void*)(intptr_t)fd;
+		} else {
+			close(fd);
+		}
+#else
 		close(fd);
+#endif
 	}
 
 #endif
@@ -78,7 +89,15 @@
 	}
 	return false;
 #else
-	return (0 == munmap(base, size));
+	bool ok = (0 == munmap(base, size));
+#ifdef __EMSCRIPTEN__
+	auto it = s_mapFiles.find(base);
+	if (it != s_mapFiles.end()) {
+		close((int)(intptr_t)it->second);
+		s_mapFiles.erase(it);
+	}
+#endif
+	return ok;
 #endif
 }
 
