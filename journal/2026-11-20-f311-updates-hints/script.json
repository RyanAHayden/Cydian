[
  { "nav": "#/home", "ms": 6000 },
  { "eval": "localStorage.getItem('ifizbox.push')" },
  { "nav": "#/home/settings/updates", "ms": 5000 },
  { "eval": "[...document.querySelectorAll('.page.is-top .group-header, .page.is-top li, .page.is-top .group-footer')].map(e => e.className.split(' ')[0] + ': ' + e.textContent.trim().replace(/\\s+/g, ' ').slice(0, 160)).join('\\n')" },
  { "eval": "[...document.querySelectorAll('.page.is-top .group-footer')].map(e => getComputedStyle(e).textAlign).join(',')" },
  { "shot": "updates" }
]
