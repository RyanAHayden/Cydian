#!/bin/sh
# A stand-in for cydian-helper (native/helper/) for tests without a device (N3, and N4's queue and console).
# Same words, same allowlist and exit codes; instead of apt it works on a fixture tree:
#   CYDIAN_PREFIX  the fake rootless prefix (etc/apt, var/lib/apt/lists, var/lib/dpkg/status)
#   FAKE_REMOTE    what "the repos" hold: FAKE_REMOTE/lists/* is what apt-get update writes into the lists dir
#   FAKE_FAIL      a verb that fails like apt does (exit 100, "E: ..." on stderr)
# Status lines go to fd 3 when it is open, like apt's APT::Status-Fd. SPDX-License-Identifier: GPL-3.0-or-later
set -u
prefix=${CYDIAN_PREFIX:?}
lists=$prefix/var/lib/apt/lists
status=$prefix/var/lib/dpkg/status
st() { { printf '%s\n' "$1" >&3; } 2>/dev/null || true; }
refuse() { echo "cydian-helper: $1" >&2; exit 64; }
verb=${1:-}
[ -n "$verb" ] || refuse "no verb (update, install, remove, upgrade, configure, hold, unhold, showhold)"
shift
case $verb in
  update|upgrade|configure|showhold) [ $# -eq 0 ] || refuse "this verb takes no arguments" ;;
  install|remove|hold|unhold) [ $# -ge 1 ] || refuse "no package names" ;;
  *) refuse "unknown verb (update, install, remove, upgrade, configure, hold, unhold, showhold)" ;;
esac
for p in "$@"; do
  printf '%s' "$p" | grep -Eqx '[a-z0-9][a-z0-9.+-]+' || refuse "bad package name (allowed: [a-z0-9][a-z0-9.+-]+)"
  case $verb in
    install) cat "$status" "$lists"/*_Packages 2>/dev/null | grep -qx "Package: $p" || refuse "unknown package: $p" ;;
    remove|hold|unhold) grep -qx "Package: $p" "$status" 2>/dev/null || refuse "unknown package: $p" ;;
  esac
done
if [ "${FAKE_FAIL:-}" = "$verb" ]; then
  echo "E: Could not get lock $lists/lock. It is held by process 1 (fake)" >&2
  exit 100
fi
case $verb in
  update)
    n=0
    for f in "${FAKE_REMOTE:?}"/lists/*; do
      [ -f "$f" ] || continue
      n=$((n + 1))
      echo "Get:$n ${f##*/}"
      st "dlstatus:$n:50:Retrieving file $n"
      cp "$f" "$lists/"
    done
    echo "Reading package lists..."
    ;;
  showhold)
    awk '/^Package:/ { p = $2 } /^Status: hold / { print p }' "$status" ;;
  hold|unhold)
    from=install to=hold
    [ "$verb" = unhold ] && from=hold to=install
    for p in "$@"; do
      awk -v p="$p" -v from="$from" -v to="$to" '
        /^Package:/ { cur = $2 }
        cur == p && $1 == "Status:" && $2 == from { sub("^Status: " from, "Status: " to) }
        { print }' "$status" > "$status.new" && mv "$status.new" "$status"
      echo "$p set to $([ "$verb" = hold ] && echo hold || echo 'manually installed')."
    done ;;
  install|remove|upgrade|configure)
    for p in "$@"; do
      st "pmstatus:$p:50:Preparing $p"
      echo "Setting up $p (fake) ..."
      st "pmstatus:$p:100:Installed $p"
    done ;;
esac
exit 0
