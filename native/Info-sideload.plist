<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keys the sideload IPA adds to Info.plist (docs/sideload.md, "What I2 needs"). mkipa.py merges them in. -->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key><array><string>audio</string><string>fetch</string></array>
	<!-- I3: the background update check (BackgroundCheck.swift), a BGAppRefreshTask. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.ryha.ifizbox.updates</string></array>
	<!-- F77: Documents (My IPAs) shows in Files under On My iPhone > iFizBox; IPAs dropped there are listed. -->
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>
	<key>CFBundleDocumentTypes</key><array>
		<dict>
			<key>CFBundleTypeName</key><string>iOS App</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>com.apple.itunes.ipa</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Signing certificate</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>com.rsa.pkcs-12</string></array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key><string>Provisioning profile</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>com.apple.mobileprovision</string></array>
		</dict>
		<!-- N9: a .deb, to say it needs a jailbreak (share/App/ShareBridge.swift) -->
		<dict>
			<key>CFBundleTypeName</key><string>Debian package</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key><array><string>org.debian.deb-archive</string></array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key><array>
		<dict>
			<key>CFBundleURLName</key><string>com.ryha.ifizbox</string>
			<key>CFBundleURLSchemes</key><array><string>ifizbox</string></array>
		</dict>
		<!-- F83: other sideloaders' links, turned into iFizBox's own (web/app/core/otherlinks.js; App.swift OtherLink holds
		     the same list). iOS gives a scheme to one app when several claim it. -->
		<dict>
			<key>CFBundleURLName</key><string>com.ryha.ifizbox.other</string>
			<key>CFBundleURLSchemes</key><array><string>altstore</string><string>altstore-classic</string><string>sidestore</string><string>feather</string><string>ksign</string><string>esign</string><string>scarlet</string><string>gbox</string><string>trollapps</string><string>stikstore</string></array>
		</dict>
	</array>
	<!-- No system type for .mobileprovision: declare it, so the document type above has something to match. -->
	<key>UTImportedTypeDeclarations</key><array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.apple.itunes.ipa</string>
			<key>UTTypeDescription</key><string>iOS App</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string><string>public.zip-archive</string></array>
			<key>UTTypeTagSpecification</key><dict>
				<key>public.filename-extension</key><array><string>ipa</string><string>tipa</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>com.apple.mobileprovision</string>
			<key>UTTypeDescription</key><string>Provisioning profile</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string></array>
			<key>UTTypeTagSpecification</key><dict>
				<key>public.filename-extension</key><array><string>mobileprovision</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key><string>org.debian.deb-archive</string>
			<key>UTTypeDescription</key><string>Debian package</string>
			<key>UTTypeConformsTo</key><array><string>public.data</string><string>public.archive</string></array>
			<key>UTTypeTagSpecification</key><dict>
				<key>public.filename-extension</key><array><string>deb</string></array>
				<key>public.mime-type</key><array><string>application/vnd.debian.binary-package</string><string>application/x-debian-package</string></array>
			</dict>
		</dict>
	</array>
	<!-- Pairing on the phone (iOS 27, IDevice.swift): the app advertises itself as a pairable host with Bonjour.
	     iOS refuses to publish a service type that isn't listed here, and asks for Local Network access with this text. -->
	<key>NSLocalNetworkUsageDescription</key><string>To pair with this iPhone in Developer Mode, so apps install without a computer.</string>
	<key>NSBonjourServices</key><array><string>_remotepairing-pairable-host._tcp</string></array>
	<!-- canOpenURL answers only for the schemes listed here: the VPN apps This iPhone connects through
	     (IDeviceBridge idevice.vpnApps: LocalDevVPN, and Tailscale's own deep-link scheme). -->
	<key>LSApplicationQueriesSchemes</key><array><string>apple-magnifier</string><string>localdevvpn</string><string>tailscale</string></array>
</dict>
</plist>
