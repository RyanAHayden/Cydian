<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key><string>com.ryha.ifizbox</string>
	<key>platform-application</key><true/>
	<key>com.apple.private.security.no-container</key><true/>
	<key>com.apple.private.security.no-sandbox</key><true/>
	<key>com.apple.private.persona-mgmt</key><true/>
	<!-- N8: the App Group the widget extension reads the update count from (intents/App/WidgetStore.swift) -->
	<key>com.apple.security.application-groups</key><array><string>group.com.ryha.ifizbox</string></array>
	<!-- F57 (Paid.swift): Keychain items for vendors' payment secrets, and the UDID vendors ask for (as Sileo has) -->
	<key>keychain-access-groups</key><array><string>com.ryha.ifizbox</string></array>
	<key>com.apple.private.MobileGestalt.AllowedProtectedKeys</key><array><string>UniqueDeviceID</string></array>
</dict>
</plist>
