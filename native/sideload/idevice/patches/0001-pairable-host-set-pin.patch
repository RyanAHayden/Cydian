+/// Sets the 6-digit setup code pair-setup uses on every later try, so the caller
+/// can show it before the device connects. NULL goes back to a random code per try.
+///
+/// # Safety
+/// `handle` must be a valid handle from `pairable_host_prepare` or
+/// `pairable_host_new`, not in use by a running `pairable_host_accept_fd`.
+/// `pin` must be NULL or a valid C string of exactly six ASCII digits.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn pairable_host_set_pin(
+    handle: *mut PairableHostHandle,
+    pin: *const c_char,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let handle = unsafe { &mut *handle };
+    if pin.is_null() {
+        handle.host_info.setup_code = None;
+        return null_mut();
+    }
+    match unsafe { CStr::from_ptr(pin) }.to_str() {
+        Ok(s) if s.len() == 6 && s.bytes().all(|b| b.is_ascii_digit()) => {
+            handle.host_info.setup_code = Some(s.to_string());
+            null_mut()
+        }
+        _ => ffi_err!(IdeviceError::FfiInvalidArg),
+    }
+}
+
