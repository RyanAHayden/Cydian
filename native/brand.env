# The product's name and identity for native/ and the Python tools (F170): the same values as web/app/brand.js
# (native/test_brand.py keeps them equal). Shell-sourceable; native/brand.py reads it for Python.
# build.sh substitutes $(BRAND_NAME) etc. in the Info.plist templates and deb/control. After changing a value run
# `python3 native/brand.py sync` (it regenerates sign/Brand.swift and the web files that can't import brand.js).
# F170 uses BRAND_NAME; F171 moved the IDs and package to BRAND_BUNDLE_ID (test_brand.py checks every com.ryha ID
# against it); the domain and repo move in F172.
BRAND_NAME=iFizBox
BRAND_DOMAIN=ifizbox.com
BRAND_SIGN_HOST=sign.ifizbox.com
BRAND_BUNDLE_ID=com.ryha.ifizbox
BRAND_PACKAGE=com.ryha.ifizbox
BRAND_GITHUB_REPO=RyanAHayden/iFizBox
