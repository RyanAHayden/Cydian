#!/bin/sh
# A stand-in for cydian-helper (native/helper/) for tests without a device (N3, and N4's queue and console).
# Same words, same allowlist and exit codes; instead of apt it works on a fixture tree (addsource/removesource
# edit $CYDIAN_PREFIX/etc/apt/sources.list.d/cydian.sources like the real one, F33):
#   CYDIAN_PREFIX  the fake rootless prefix (etc/apt, var/lib/apt/lists, var/lib/dpkg/status)
#   FAKE_REMOTE    what "the repos" hold: FAKE_REMOTE/lists/* is what apt-get update writes into the lists dir
#   FAKE_FAIL      a verb that fails like apt does (exit 100, "E: ..." on stderr); simulate fails with an unmet
#                  dependency of the first item on FAKE_MISSING (default com.example.missing), as apt-get -s does
#   FAKE_SLOW      seconds apply waits before each package, so a walk-through sees the console mid-run
#   FAKE_CONFFILE  a conffile path both the user and the package changed (F63): apply keeps it quietly, apply-ask
#                  asks on fd 3 (pmconffile:) and reads Y or N from stdin, as dpkg does through the real helper
#   FAKE_FINISH    apply writes "finish:$FAKE_FINISH" to fd 3, as a maintainer script does through $CYDIA (N4)
#   CYDIAN_IPA_DIR install-ipa's one directory (F59; the real one's HELPER_IPA_DIR). install-ipa reads the IPA's
#                  bundle id like ipa.c and "installs" it into $CYDIAN_PREFIX/var/fake-installed-ipas:
#   FAKE_APPSYNC=1 AppSync Unified is there (the IPA goes to installd as it is); else FAKE_LDID=1 means ldid signs it
#                  ad hoc first, and neither is exit 69 (can't install ad hoc). A bundle id ending in .refused makes
#                  the fake installd refuse an ad hoc app (exit 69) or an AppSync one (exit 1)
#   rollbacks/rollback (F71) work on $CYDIAN_PREFIX/var/cache/cydian/rollback/<id>/ like the real ones: a "stored
#                  .deb" here is a plain text control stanza (Package, Version, ...), which rollback writes into dpkg's
#                  status in place of the installed one. Ownership isn't checked (the tests run as one user)
#   install-paid (F57) takes a "downloaded .deb" from $CYDIAN_PAID_DIR (the real one's HELPER_PAID_DIR): a plain text
#                  control stanza as rollback's, checked to be the package and version asked, then written into
#                  dpkg's status like rollback does. FAKE_FAIL=install-paid fails like apt (exit 100)
# Status lines go to fd 3 when it is open, like apt's APT::Status-Fd. SPDX-License-Identifier: GPL-3.0-or-later
set -u
prefix=${CYDIAN_PREFIX:?}
lists=$prefix/var/lib/apt/lists
status=$prefix/var/lib/dpkg/status
st() { { printf '%s\n' "$1" >&3; } 2>/dev/null || true; }
refuse() { echo "cydian-helper: $1" >&2; exit 64; }
verb=${1:-}
VERBS="update, install, remove, upgrade, configure, hold, unhold, showhold, addsource, removesource, simulate, apply, apply-ask, respring, install-ipa, selfupdate, rollbacks, rollback, install-paid"
[ -n "$verb" ] || refuse "no verb ($VERBS)"
shift
sources=$prefix/etc/apt/sources.list.d/cydian.sources
# F33: the same checks as policy.c's helper_uri_ok, helper_suite_ok and helper_component_ok. grep -x matches a
# line, so a value with a newline in it ("https://r/\nTrusted: yes") is refused first.
one_line() { case $1 in *"
"*) return 1 ;; esac; }
uri_ok() {
  one_line "$1" && [ ${#1} -le 1024 ] && printf '%s' "$1" | grep -Eqx 'https?://[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?/([A-Za-z0-9._~%+/:=,-]*/)?' &&
    ! printf '%s' "${1#*://}" | grep -Eq '/\.\.?/'
}
suite_ok() {
  [ "$1" = ./ ] && return 0
  one_line "$1" && [ ${#1} -le 255 ] && printf '%s' "$1" | grep -Eqx '[A-Za-z0-9._+][A-Za-z0-9._+/-]*' &&
    ! printf '%s' "$1" | grep -Eq '(^|/)\.\.?(/|$)'
}
component_ok() {
  one_line "$1" && [ ${#1} -le 64 ] && printf '%s' "$1" | grep -Eqx '[A-Za-z0-9]([A-Za-z0-9._+/-]*[A-Za-z0-9._+-])?' &&
    ! printf '%s' "$1" | grep -Eq '(^|/)\.\.?(/|$)'
}
case $verb in
  addsource|removesource)
    [ $# -ge 2 ] || refuse "needs a URI and a suite"
    uri_ok "$1" || refuse "bad URI (http(s)://host[:port]/path/, ending in /, no user, spaces or . segments)"
    suite_ok "$2" || refuse "bad suite"
    uri=$1 suite=$2
    shift 2
    if [ "$verb" = removesource ]; then
      [ $# -eq 0 ] || refuse "removesource takes a URI and a suite only"
    else
      case $suite in
        */) [ $# -eq 0 ] || refuse "a flat suite (ending in /) takes no components" ;;
        *) [ $# -ge 1 ] || refuse "a suite that isn't flat needs components" ;;
      esac
      [ $# -le 16 ] || refuse "too many components"
      for c in "$@"; do component_ok "$c" || refuse "bad component"; done
    fi
    if [ "${FAKE_FAIL:-}" = "$verb" ]; then
      echo "cydian-helper: can't create a temp file in sources.list.d: Permission denied (fake)" >&2
      exit 74
    fi
    mine=
    if [ "$verb" = addsource ]; then
      mine="Types: deb
URIs: $uri
Suites: $suite"
      [ $# -gt 0 ] && mine="$mine
Components: $*"
    fi
    mkdir -p "${sources%/*}"
    tmp="${sources%/*}/.cydian.sources.$$"
    # One stanza per paragraph; the first naming exactly this URI and suite becomes ours, the rest go.
    { cat "$sources" 2>/dev/null || true; } | awk -v uri="$uri" -v suite="$suite" -v mine="$mine" '
      BEGIN { RS = ""; placed = (mine == "") }
      {
        u = ""; s = ""
        n = split($0, l, "\n")
        for (i = 1; i <= n; i++) {
          if (tolower(l[i]) ~ /^uris:/) { u = l[i]; sub(/^[^:]*:[ \t]*/, "", u); sub(/[ \t\r]*$/, "", u) }
          if (tolower(l[i]) ~ /^suites:/) { s = l[i]; sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t\r]*$/, "", s) }
        }
        out = $0
        if (u == uri && s == suite) { if (placed) next; placed = 1; out = mine }
        printf "%s%s\n", (k++ ? "\n" : ""), out
      }
      END { if (!placed) printf "%s%s\n", (k ? "\n" : ""), mine }' > "$tmp"
    if cmp -s "$tmp" "$sources" || { [ ! -s "$tmp" ] && [ ! -e "$sources" ]; }; then
      rm -f "$tmp"
      what="nothing to change"
    elif [ -s "$tmp" ]; then
      chmod 644 "$tmp" && mv "$tmp" "$sources"
      what="cydian.sources updated"
    else
      rm -f "$tmp" "$sources"
      what="cydian.sources updated"
    fi
    echo "$([ "$verb" = addsource ] && echo Added || echo Removed) $uri $suite: $what"
    exit 0 ;;
  update|upgrade|configure|showhold) [ $# -eq 0 ] || refuse "this verb takes no arguments" ;;
  install|remove|hold|unhold) [ $# -ge 1 ] || refuse "no package names" ;;
  simulate|apply|apply-ask) [ $# -ge 1 ] || refuse "no packages" ;;
  respring) [ $# -eq 0 ] || refuse "this verb takes no arguments"; echo "sbreload (fake)"; exit 0 ;;
  install-ipa)
    # F59: policy.c's helper_ipa_path_ok, then ipa.c's steps without installd.
    [ $# -eq 1 ] || refuse "install-ipa takes one path"
    dir=${CYDIAN_IPA_DIR:?}
    case $1 in "$dir"/*) name=${1#"$dir"/} ;; *) name= ;; esac
    { one_line "$1" && [ ${#name} -le 255 ] && printf '%s' "$name" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._-]*\.ipa' &&
      case $name in *..*) false ;; esac; } || refuse "bad IPA path (only $dir/<name>.ipa)"
    { [ -f "$1" ] && [ ! -L "$1" ]; } || refuse "can't open the IPA (missing, or a link)"
    st "pmstatus:ipa:5:Copying the IPA"
    st "pmstatus:ipa:20:Unpacking"
    id=$(python3 -I -c '
import re, sys, zipfile
try:
    z = zipfile.ZipFile(sys.argv[1])
except Exception:
    sys.exit(9)
apps = {n.split("/")[1] for n in z.namelist() if re.match(r"Payload/[^/]+\.app/", n)}
if len(apps) != 1:
    sys.exit(8)
try:
    text = z.read("Payload/%s/Info.plist" % apps.pop()).decode("utf-8", "replace")
except KeyError:
    sys.exit(7)
m = re.search(r"<key>CFBundleIdentifier</key>\s*<string>([^<]*)</string>", text)
v = m.group(1) if m else ""
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,254}", v):
    sys.exit(7)
print(v)' "$1")
    case $? in
      0) ;;
      9) refuse "unzip couldn't unpack the IPA" ;;
      8) refuse "not an IPA: no single Payload/<name>.app" ;;
      *) refuse "no usable CFBundleIdentifier in the app's Info.plist" ;;
    esac
    if [ "${FAKE_APPSYNC:-}" = 1 ]; then
      st "pmstatus:$id:50:Installing (AppSync Unified)"
      echo "install ipa $id"
      case $id in *.refused) echo "cydian-helper: installd: fake installd refused it" >&2
        echo "cydian-helper: installd refused the app" >&2; exit 1 ;; esac
    elif [ "${FAKE_LDID:-}" = 1 ]; then
      st "pmstatus:$id:40:Signing ad hoc (ldid)"
      echo "ldid -s Payload/$id.app (fake)"
      st "pmstatus:$id:60:Installing (ad hoc signed)"
      echo "install app $id (PackageType Developer)"
      case $id in *.refused) echo "cydian-helper: installd: fake installd refused it" >&2
        echo "cydian-helper: installd refused the ad hoc signed app: this jailbreak can't install ad hoc apps without AppSync Unified. Install AppSync Unified, or sign the IPA for this iPhone first" >&2
        exit 69 ;; esac
    else
      echo "cydian-helper: AppSync Unified isn't installed and there's no ldid to sign the app ad hoc: install AppSync Unified or ldid, or sign the IPA for this iPhone first" >&2
      exit 69
    fi
    echo "$id" >> "$prefix/var/fake-installed-ipas"
    st "pmstatus:$id:100:Installed"
    echo "Installed $id"
    exit 0 ;;
  rollbacks|rollback)
    # F71: policy.c's rollback_plan, helper_rollback_file/list and helper_rollback_verify.
    if [ "$verb" = rollbacks ]; then [ $# -eq 1 ] || refuse "rollbacks takes a package name"
    else [ $# -eq 2 ] || refuse "rollback takes a package name and a version"; fi
    { one_line "$1" && printf '%s' "$1" | grep -Eqx '[a-z0-9][a-z0-9.+-]{1,254}'; } || refuse "bad package name (allowed: [a-z0-9][a-z0-9.+-]+)"
    if [ "$verb" = rollback ]; then
      { one_line "$2" && printf '%s' "$2" | grep -Eqx '[0-9][A-Za-z0-9.+~:-]{0,254}'; } || refuse "bad version (a digit, then [A-Za-z0-9.+~:-])"
    fi
    store=$prefix/var/cache/cydian/rollback/$1
    found=
    for f in "$store/$1"_*_*.deb; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      rest=${f##*/}; rest=${rest#"$1"_}; arch=${rest##*_}; ver=${rest%_*}
      printf '%s' "$ver" | grep -Eqx '[0-9][A-Za-z0-9.+~%-]*' && printf '%s' "${arch%.deb}" | grep -Eqx '[a-z0-9-]+' || continue
      case $ver in *_*) continue ;; esac
      ver=$(printf '%s' "$ver" | sed 's/%3[aA]/:/g')
      if [ "$verb" = rollbacks ]; then echo "$ver ${f##*/}"
      elif [ "$ver" = "$2" ]; then found=$f; break; fi
    done
    [ "$verb" = rollbacks ] && exit 0
    [ -n "$found" ] || refuse "no stored .deb of that version (Roll Back keeps only what automatic updates replaced)"
    { grep -qxF "Package: $1" "$found" && grep -qxF "Version: $2" "$found" &&
      [ "$(grep -c '^Package:' "$found")" = 1 ] && [ "$(grep -c '^Version:' "$found")" = 1 ]; } ||
      refuse "the stored .deb's control isn't that package and version"
    [ -n "${FAKE_SLOW:-}" ] && sleep "$FAKE_SLOW"
    echo "Reading package lists..."
    old=$(awk -v p="$1" 'BEGIN { RS = "" } { n = split($0, l, "\n"); name = ""; v = ""
      for (i = 1; i <= n; i++) { if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
        if (l[i] ~ /^Version:/) { v = l[i]; sub(/^Version:[ \t]*/, "", v) } }
      if (name == p) { print v; exit } }' "$status" 2>/dev/null)
    st "pmstatus:$1:50:Preparing $1"
    echo "Unpacking $1 ($2)${old:+ over ($old)} ..."
    if [ "${FAKE_FAIL:-}" = rollback ]; then
      echo "dpkg: error processing archive $found (--unpack):" >&2
      echo "E: Sub-process /usr/bin/dpkg returned an error code (1)" >&2
      exit 100
    fi
    { awk -v p="$1" 'BEGIN { RS = ""; ORS = "\n\n" } { n = split($0, l, "\n"); name = ""
        for (i = 1; i <= n; i++) if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
        if (name != p) print }' "$status"
      awk 'NR == 1 { print; print "Status: install ok installed"; next } { print }' "$found"
      echo; } > "$status.new" && mv "$status.new" "$status"
    echo "Setting up $1 ($2) ..."
    st "pmstatus:$1:100:Installed $1"
    [ -n "${FAKE_FINISH:-}" ] && st "finish:$FAKE_FINISH"
    exit 0 ;;
  install-paid)
    # F57: policy.c's paid_plan (helper_paid_path_ok, name, version), then paid.c's control check and apt-get install.
    [ $# -eq 3 ] || refuse "install-paid takes a .deb path, a package name and a version"
    dir=${CYDIAN_PAID_DIR:?}
    case $1 in "$dir"/*) name=${1#"$dir"/} ;; *) name= ;; esac
    { one_line "$1" && [ ${#name} -le 255 ] && printf '%s' "$name" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._-]*\.deb' &&
      case $name in *..*) false ;; esac; } || refuse "bad .deb path (only $dir/<name>.deb)"
    { one_line "$2" && printf '%s' "$2" | grep -Eqx '[a-z0-9][a-z0-9.+-]{1,254}'; } || refuse "bad package name (allowed: [a-z0-9][a-z0-9.+-]+)"
    { one_line "$3" && printf '%s' "$3" | grep -Eqx '[0-9][A-Za-z0-9.+~:-]{0,254}'; } || refuse "bad version (a digit, then [A-Za-z0-9.+~:-])"
    { [ -f "$1" ] && [ ! -L "$1" ] && [ -s "$1" ]; } || refuse "can't open the .deb (missing, or a link)"
    deb=$(sed '1{/^!<arch>$/d}' "$1")
    { printf '%s\n' "$deb" | grep -qxF "Package: $2" && printf '%s\n' "$deb" | grep -qxF "Version: $3" &&
      [ "$(printf '%s\n' "$deb" | grep -c '^Package:')" = 1 ] && [ "$(printf '%s\n' "$deb" | grep -c '^Version:')" = 1 ]; } ||
      refuse "the downloaded .deb isn't that package and version"
    echo "Reading package lists..."
    st "pmstatus:$2:50:Preparing $2"
    echo "Unpacking $2 ($3) ..."
    if [ "${FAKE_FAIL:-}" = install-paid ]; then
      echo "E: Sub-process /usr/bin/dpkg returned an error code (1)" >&2
      exit 100
    fi
    { awk -v p="$2" 'BEGIN { RS = ""; ORS = "\n\n" } { n = split($0, l, "\n"); name = ""
        for (i = 1; i <= n; i++) if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
        if (name != p) print }' "$status"
      printf '%s\n' "$deb" | awk 'NR == 1 { print; print "Status: install ok installed"; next } { print }'
      echo; } > "$status.new" && mv "$status.new" "$status"
    echo "Setting up $2 ($3) ..."
    st "pmstatus:$2:100:Installed $2"
    exit 0 ;;
  *) refuse "unknown verb ($VERBS)" ;;
esac
# N4: the versions of package $2 in file(s) $1..., one per line (status: installed ones only).
versions_in() {
  p=$1; shift
  awk -v p="$p" 'BEGIN { RS = "" } {
    n = split($0, l, "\n"); name = ""; v = ""; st = ""
    for (i = 1; i <= n; i++) {
      if (l[i] ~ /^Package:/) { name = l[i]; sub(/^Package:[ \t]*/, "", name) }
      if (l[i] ~ /^Version:/) { v = l[i]; sub(/^Version:[ \t]*/, "", v) }
      if (l[i] ~ /^Status:/) st = l[i]
    }
    if (name == p && v != "" && (st == "" || st ~ / installed$/)) print v
  }' "$@" 2>/dev/null
}
installed_version() { versions_in "$1" "$status" | head -n 1; }
# A stanza's Package and Version, by field (names hold "." and "+", so no regexes on them).
FIELDS='function field(f,   n, l, i, v) { n = split($0, l, "\n"); for (i = 1; i <= n; i++) if (index(l[i], f ":") == 1) { v = substr(l[i], length(f) + 2); sub(/^[ \t]*/, "", v); sub(/[ \t\r]*$/, "", v); return v } return "" }'
# The stanza of package $1 at version $2 from apt's lists (for apply's new status entry).
stanza_of() {
  awk -v p="$1" -v v="$2" "$FIELDS"' BEGIN { RS = "" } field("Package") == p && field("Version") == v { print; exit }' "$lists"/*_Packages 2>/dev/null
}
# dpkg's status without package $1.
drop_pkg() { awk -v p="$1" "$FIELDS"' BEGIN { RS = ""; ORS = "\n\n" } field("Package") != p' "$status"; }
# F63: dpkg's conffile question for $FAKE_CONFFILE, once per run (after the first install item's unpack). apply
# keeps the old copy silently (--force-confold); apply-ask asks on fd 3 as apt's pmconffile: line and reads the
# answer as the real helper relays it: only "Y" or "N" lines count (others: the helper's warning), end of file is
# dpkg's error. The outcome goes into $CYDIAN_PREFIX/var/fake-conffiles as "keep <file>" or "new <file>".
asked=
conffile() {
  [ -n "${FAKE_CONFFILE:-}" ] && [ -z "$asked" ] || return 0
  asked=1
  f=$FAKE_CONFFILE
  if [ "$verb" = apply ]; then echo "keep $f" >> "$prefix/var/fake-conffiles"; return 0; fi
  echo ""
  echo "Configuration file '$f'"
  echo " ==> Modified (by you or by a script) since installation."
  echo " ==> Package distributor has shipped an updated version."
  echo " The default action is to keep your current version."
  echo "*** ${f##*/} (Y/I/N/O/D/Z) [default=N] ?"
  st "pmconffile:$f:60:'$f' '$f.dpkg-new' 1 1"
  while :; do
    if ! IFS= read -r ans <&5; then
      echo "dpkg: error processing package $1 (--configure):"
      echo " end of file on stdin at conffile prompt"
      echo "E: Sub-process /usr/bin/dpkg returned an error code (1)" >&2
      exit 100
    fi
    case $ans in
      Y) echo "Installing new version of config file $f ..."; echo "new $f" >> "$prefix/var/fake-conffiles"; return 0 ;;
      N) echo "keep $f" >> "$prefix/var/fake-conffiles"; return 0 ;;
      *) echo "cydian-helper: ignored an answer that isn't Y or N" >&2 ;;
    esac
  done
}
exec 5<&0
if [ "$verb" = simulate ] || [ "$verb" = apply ] || [ "$verb" = apply-ask ]; then
  [ "$verb" != apply-ask ] || { : >&3; } 2>/dev/null || refuse "apply-ask needs the status fd (3) to ask on"
  seen=" "
  for w in "$@"; do
    one_line "$w" || refuse "bad package name (allowed: [a-z0-9][a-z0-9.+-]+)"
    case $w in
      -*) name=${w#-} ver= ;;
      *=*) name=${w%%=*} ver=${w#*=}
        printf '%s' "$ver" | grep -Eqx '[0-9][A-Za-z0-9.+~:-]{0,254}' || refuse "bad version (a digit, then [A-Za-z0-9.+~:-])" ;;
      *) name=$w ver= ;;
    esac
    printf '%s' "$name" | grep -Eqx '[a-z0-9][a-z0-9.+-]+' || refuse "bad package name (allowed: [a-z0-9][a-z0-9.+-]+)"
    case $w in -*) ;; *[-+]|*[-+]=*) refuse "bad package name (allowed: [a-z0-9][a-z0-9.+-]+)" ;; esac
    case $seen in *" $name "*) refuse "a package is named twice" ;; esac
    seen="$seen$name "
    case $w in
      -*) grep -qx "Package: $name" "$status" 2>/dev/null || refuse "unknown package: $name" ;;
      *) cat "$status" "$lists"/*_Packages 2>/dev/null | grep -qx "Package: $name" || refuse "unknown package: $name" ;;
    esac
  done
  if [ "${FAKE_FAIL:-}" = simulate ] && [ "$verb" = simulate ]; then
    first=${1#-}; first=${first%%=*}
    echo "Reading package lists..."
    echo "Building dependency tree..."
    echo "Some packages could not be installed. This may mean that you have"
    echo "requested an impossible situation."
    echo ""
    echo "The following packages have unmet dependencies:"
    echo " $first : Depends: ${FAKE_MISSING:-com.example.missing} but it is not installable"
    echo "E: Unable to correct problems, you have held broken packages." >&2
    exit 100
  fi
  # What apt would do, item by item (no dependency resolution in the fake).
  plan=
  for w in "$@"; do
    case $w in
      -*) name=${w#-}; old=$(installed_version "$name")
        [ -n "$old" ] || { echo "Package '$name' is not installed, so not removed"; continue; }
        plan="$plan
R $name $old" ;;
      *) name=${w%%=*}; ver=; case $w in *=*) ver=${w#*=} ;; esac
        old=$(installed_version "$name")
        if [ -n "$ver" ]; then
          versions_in "$name" "$lists"/*_Packages | grep -qxF "$ver" || { echo "E: Version '$ver' for '$name' was not found" >&2; exit 100; }
        else
          ver=$(versions_in "$name" "$lists"/*_Packages | head -n 1)
          [ -n "$ver" ] || { echo "E: Package '$name' has no installation candidate" >&2; exit 100; }
        fi
        plan="$plan
I $name $ver $old" ;;
    esac
  done
  if [ "$verb" = simulate ]; then
    echo "Reading package lists..."
    echo "Building dependency tree..."
    echo "NOTE: This is only a simulation!"
    printf '%s\n' "$plan" | while read -r kind name ver old; do
      case $kind in
        R) echo "Remv $name [$ver]" ;;
        I) if [ -n "$old" ]; then echo "Inst $name [$old] ($ver Fake:1.0/stable [iphoneos-arm64])"
           else echo "Inst $name ($ver Fake:1.0/stable [iphoneos-arm64])"; fi ;;
      esac
    done
    printf '%s\n' "$plan" | while read -r kind name ver old; do
      [ "$kind" = I ] && echo "Conf $name ($ver Fake:1.0/stable [iphoneos-arm64])"
    done
    exit 0
  fi
  echo "Reading package lists..."
  printf '%s\n' "$plan" | while read -r kind name ver old; do
    [ -n "$kind" ] || continue
    [ -n "${FAKE_SLOW:-}" ] && sleep "$FAKE_SLOW"
    if [ "$kind" = R ]; then
      st "pmstatus:$name:30:Removing $name"
      echo "Removing $name ($ver) ..."
      drop_pkg "$name" > "$status.new"
    else
      st "dlstatus:$name:20:Retrieving $name"
      echo "Get:1 https://fake.example ./ $name $ver [100 B]"
      st "pmstatus:$name:50:Preparing $name"
      echo "Unpacking $name ($ver)${old:+ over ($old)} ..."
      conffile "$name"
      new=$(stanza_of "$name" "$ver")
      { drop_pkg "$name"
        printf '%s\n' "$new" | awk 'NR == 1 { print; print "Status: install ok installed"; next } { print }'
        echo; } > "$status.new"
      echo "Setting up $name ($ver) ..."
      st "pmstatus:$name:100:Installed $name"
    fi
    mv "$status.new" "$status"
  done || exit $? # conffile's end-of-file error, from inside the loop's subshell
  if [ "${FAKE_FAIL:-}" = apply ] || [ "${FAKE_FAIL:-}" = "$verb" ]; then
    echo "dpkg: error processing package ${1#-} (--configure):"
    echo "E: Sub-process /usr/bin/dpkg returned an error code (1)" >&2
    exit 100
  fi
  [ -n "${FAKE_FINISH:-}" ] && st "finish:$FAKE_FINISH"
  exit 0
fi
for p in "$@"; do
  # B5: grep -x matches a line, so "ab\n--force-yes" would pass; the real helper refuses it, so refuse it first.
  one_line "$p" && printf '%s' "$p" | grep -Eqx '[a-z0-9][a-z0-9.+-]+' || refuse "bad package name (allowed: [a-z0-9][a-z0-9.+-]+)"
  case $verb in
    install) cat "$status" "$lists"/*_Packages 2>/dev/null | grep -qx "Package: $p" || refuse "unknown package: $p" ;;
    remove|hold|unhold) grep -qx "Package: $p" "$status" 2>/dev/null || refuse "unknown package: $p" ;;
  esac
done
if [ "${FAKE_FAIL:-}" = "$verb" ]; then
  echo "E: Could not get lock $lists/lock. It is held by process 1 (fake)" >&2
  exit 100
fi
case $verb in
  update)
    n=0
    for f in "${FAKE_REMOTE:?}"/lists/*; do
      [ -f "$f" ] || continue
      n=$((n + 1))
      echo "Get:$n ${f##*/}"
      st "dlstatus:$n:50:Retrieving file $n"
      cp "$f" "$lists/"
    done
    echo "Reading package lists..."
    ;;
  showhold)
    awk '/^Package:/ { p = $2 } /^Status: hold / { print p }' "$status" ;;
  hold|unhold)
    from=install to=hold
    [ "$verb" = unhold ] && from=hold to=install
    for p in "$@"; do
      awk -v p="$p" -v from="$from" -v to="$to" '
        /^Package:/ { cur = $2 }
        cur == p && $1 == "Status:" && $2 == from { sub("^Status: " from, "Status: " to) }
        { print }' "$status" > "$status.new" && mv "$status.new" "$status"
      echo "$p set to $([ "$verb" = hold ] && echo hold || echo 'manually installed')."
    done ;;
  install|remove|upgrade|configure)
    for p in "$@"; do
      st "pmstatus:$p:50:Preparing $p"
      echo "Setting up $p (fake) ..."
      st "pmstatus:$p:100:Installed $p"
    done ;;
esac
exit 0
